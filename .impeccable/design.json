  "narrative": {
    "northStar": "The Research Workbench",
    "overview": "A light, compact research workspace keeps company discovery beside price evidence and business context. White surfaces, a cool gray ground, blue selection, fine dividers, and Manrope make dense information approachable without sacrificing hierarchy.\n\nThis document records the implemented discovery and company-details milestone. The navy marketing landing page, portfolio persistence, and company notes remain future work; starter surfaces do not establish their finished visual systems.",
    "keyCharacteristics": [
      "Compact discovery list, dominant chart, and contextual company rail.",
      "Quiet surfaces with softly elevated dropdowns.",
      "Real company logos, graceful initial fallbacks, and clear selected checkmarks.",
      "Compact on-demand provenance, restrained motion, and tabular financial figures."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Use blue for research interaction and chart evidence; reserve green and red for signed changes.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep research panels visually still; reserve stronger elevation for temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the chart's dominance and keep company context nearby.",
      "Do retain real company logos with initial fallbacks, selected tints, and checkmarks.",
      "Do keep the dated price and compact Data popover together.",
      "Do preserve keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't add a left selection stripe.",
      "Don't restore status dots, source banners, repeated footers, or verbose provenance in the context rail.",
      "Don't introduce heavy card shadows or dramatic stock-content motion.",
      "Don't present the planned landing page or portfolio as completed."
    ]
  }
